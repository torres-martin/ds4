<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Bolsa de Trabajo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Glassmorphism (tipo vidrio) -->
    <link href="~/Content/glass.css" rel="stylesheet" />
</head>
<body>
    @{
        var u = Session["USER"] as BolsaTrabajoWeb.Models.SessionUser;
    }
    <nav class="navbar navbar-expand-lg navbar-dark glass-nav">
        <div class="container">
            <a class="navbar-brand fw-bold" href="@Url.Action("Index","Ofertas")">
                Bolsa de Trabajo
            </a>

            <div class="ms-auto d-flex align-items-center gap-2">
                @if (u == null)
                {
                    <a class="btn btn-outline-light btn-sm"
                       href="@Url.Action("Login","Auth")">Login</a>

                    <a class="btn btn-primary btn-sm"
                       href="@Url.Action("Register","Auth")">Registro</a>
                }
                else
                {
                    <span class="text-white-50 me-2 small">
                        (@u.Rol) @u.Email
                    </span>

                    if (u.Rol == "Empleado")
                    {
                        <a class="btn btn-outline-light btn-sm"
                           href="@Url.Action("MisAplicaciones","Aplicaciones")">
                            Mis aplicaciones
                        </a>

                        <a class="btn btn-outline-light btn-sm"
                           href="@Url.Action("Empleado","Perfil")">
                            Perfil
                        </a>
                    }
                    else if (u.Rol == "Empleador")
                    {
                        <a class="btn btn-outline-light btn-sm"
                           href="@Url.Action("MisPublicaciones","Ofertas")">
                            Mis ofertas
                        </a>

                        <a class="btn btn-outline-light btn-sm"
                           href="@Url.Action("Create","Ofertas")">
                            Publicar
                        </a>

                        <a class="btn btn-outline-light btn-sm"
                           href="@Url.Action("Empleador","Perfil")">
                            Perfil
                        </a>
                    }

                    <a class="btn btn-danger btn-sm"
                       href="@Url.Action("Logout","Auth")">
                        Salir
                    </a>
                }
            </div>
        </div>
    </nav>

    <!-- CONTENIDO -->
    <div class="page-wrap">
        <div class="glass-shell">
            @RenderBody()
        </div>
    </div>

</body>
</html>
